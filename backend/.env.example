# Copy to .env and fill in. .env is gitignored.
#
# NEVER commit a real key. Nothing in this file reaches the
# ESP32 -- the firmware holds only the Wi-Fi credentials and
# the backend token (see sketch_bkl/src/net/Secrets.example.h).

# ---- Backend ----
CHOTUBOT_HOST=0.0.0.0
CHOTUBOT_PORT=8080
CHOTUBOT_TOKEN=generate-a-long-random-string

# ---- LLM provider ----
# fake      offline keyword rules, no key needed (default)
# anthropic the real Messages API
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# LLM_MODEL=claude-opus-5
# LLM_MAX_TOKENS=1024
# LLM_EFFORT=medium

# ---- Spotify ----
# fake  offline in-memory library, no account needed (default)
# web   the real Spotify Web API
SPOTIFY_SERVICE=fake

# Required only when SPOTIFY_SERVICE=web.
#
# Create an app at developer.spotify.com, then obtain a
# refresh token once via the Authorization Code flow with
# scopes: user-read-playback-state user-modify-playback-state
#
# Playback control (play/pause/skip) needs Spotify Premium.
# Search and now-playing work on a free account.
#
# These NEVER reach the ESP32 -- the bot only receives the
# normalized spotify_state message (track, artist, progress).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
